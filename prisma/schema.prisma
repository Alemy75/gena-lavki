generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Category {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  sortOrder Int           @default(0)
  updatedAt DateTime      @default(now()) @updatedAt
  items     CatalogItem[]

  @@map("category")
}

model CatalogItem {
  id          Int                 @id @default(autoincrement())
  name        String
  description String              @default("")
  specs       String              @default("")
  image       String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  categoryId  Int?
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      CatalogItemImage[]

  @@map("catalog_item")
}

model CatalogItemImage {
  id            Int         @id @default(autoincrement())
  catalogItemId Int
  url           String
  sortOrder     Int         @default(0)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([catalogItemId])
  @@map("catalog_item_image")
}

model SiteSettings {
  id       Int    @id @default(1)
  siteName String @default("")
  phone    String @default("")
  email    String @default("")
  address  String @default("")

  @@map("site_settings")
}

model SocialLink {
  id        Int    @id @default(autoincrement())
  label     String
  url       String
  icon      String @default("")
  sortOrder Int    @default(0)

  @@map("social_link")
}

/// Заявки с формы, если SMTP недоступен и включён CONTACT_SAVE_IF_MAIL_FAILS
model Page {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  title     String
  content   String   @default("")
  updatedAt DateTime @updatedAt

  @@map("page")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  name      String
  email     String
  phone     String
  consent   Boolean
  product   String?

  @@map("contact_message")
}
